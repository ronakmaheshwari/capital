{
    "name": "@repo/tests",
    "version": "1.0.0",
    "description": "Shared Jest unit and integration tests for the Capital monorepo",
    "private": true,
    "scripts": {
        "test": "jest",
        "test:unit": "jest --testPathPattern=unit",
        "test:integration": "jest --testPathPattern=integration",
        "test:coverage": "jest --coverage",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --coverage --forceExit"
    },
    "devDependencies": {
        "@repo/notifications": "*",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "jest-mock-extended": "^3.0.7",
        "jsonwebtoken": "^9.0.2",
        "supertest": "^7.1.0",
        "ts-jest": "^29.3.4",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "libsodium-wrappers": "^0.7.15"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "setupFiles": [
            "./jest.setup.ts"
        ]
    }
}
