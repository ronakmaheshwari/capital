{
    "name": "@repo/benchmark",
    "version": "1.0.0",
    "description": "Benchmark data generator and k6 load test scripts for the Capital ticketing system",
    "type": "module",
    "scripts": {
        "generate": "node --loader ts-node/esm --experimental-specifier-resolution=node src/generator/index.ts",
        "generate:compiled": "node dist/generator/index.js",
        "build": "tsc -b",
        "test": "echo \"No unit tests in benchmark package\" && exit 0"
    },
    "dependencies": {
        "@repo/db": "*",
        "@repo/keygen": "*",
        "@repo/notifications": "*",
        "bcrypt": "^6.0.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^16.6.1",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.18.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
