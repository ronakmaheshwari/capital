# Benchmark Generator — Environment Variables
#
# Copy this file to packages/benchmark/.env and fill in your values.
# The generator also automatically reads apps/http/.env as a fallback.
#
# All values must match those used by the production HTTP server.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/postgres"

# ── Authentication ────────────────────────────────────────────────────────────
# Must match JWT_SECRET in apps/http/.env
JWT_SECRET="123456"

# ── Private Key Encryption ────────────────────────────────────────────────────
# Must match SECRET_SALT in apps/http/.env
# This is used to encrypt/decrypt Ed25519 private keys stored in the DB.
SECRET_SALT="8f39d7b4a9e0c6d129cbb14f0f43a15d4e0bda1d6d66e4d914b41e0f09eac4c7"

# ── Ticket Payload Encryption ─────────────────────────────────────────────────
# Must match TICKET_SECRET_KEY in apps/http/.env (apps/validator/.env)
# Used by XSalsa20-Poly1305 to encrypt the signed ticket payload.
TICKET_SECRET_KEY="mcF8l3hSVWBWUyYsNx5U4rM2Otp_SJ-hcZ5HwQ-S6UQ"

# ── bcrypt ────────────────────────────────────────────────────────────────────
SALT_ROUNDS="10"
