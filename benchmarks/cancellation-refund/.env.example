# Environment Variables for Cancellation/Refund Benchmark
# Copy this file to .env and fill in your values.
# The root .env at /Users/ronak/Documents/capital-1/.env is loaded automatically.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Application ─────────────────────────────────────────────────────────────
# HTTP API (apps/http, port 3001)
BASE_URL=http://localhost:3001/api/v1

# Webhook API (apps/webhook, port 3002)
WEBHOOK_URL=http://localhost:3002/api/v1/webhook

# JWT secret – must match apps/http JWT_SECRET
JWT_SECRET=123456

# ─── Benchmark Safety ─────────────────────────────────────────────────────────
# REQUIRED: Seeders refuse to run unless this is exactly "true"
BENCHMARK_MODE=true

# ─── Workload Parameters ──────────────────────────────────────────────────────
# Number of tickets to create for the cancellation seeder
TICKET_COUNT=100

# Refund amount per ticket (must match event slot price)
REFUND_AMOUNT=100

# ─── k6 Parameters ────────────────────────────────────────────────────────────
K6_VUS=1
K6_DURATION=30s

# Polling for E2E refund completion
POLL_INTERVAL_MS=200
POLL_TIMEOUT_MS=30000

# Arrival-rate testing
ARRIVAL_RATE=10
REPETITIONS=5
