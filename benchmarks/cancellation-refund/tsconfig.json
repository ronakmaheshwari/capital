{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "config/**/*",
    "seeders/**/*",
    "verification/**/*",
    "instrumentation/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist", "k6", "results"]
}
